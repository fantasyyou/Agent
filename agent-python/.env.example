# Copy this file to .env and replace the placeholder values.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
PYTHON_LOG_LEVEL=INFO
GO_LOG_LEVEL=INFO

# Optional published ports. Container names are fixed to match agent-go/config.json.
WEB_PORT=8081
PYTHON_DEBUG_PORT=8080
AGENT_NETWORK_NAME=agent-network
JAEGER_PORT=16686

# Fixed volumes reused by start.sh: es_data, mysql_data, redis_data, agent_jaeger_data.
# Credentials below initialize NEW databases only; existing data retains its credentials.
ELASTIC_PASSWORD=elastic

# start.sh creates MySQL on first deployment, then reuses it.
MYSQL_CONTAINER_NAME=mysql
MYSQL_ROOT_PASSWORD=mysql-root-password
MYSQL_USER=agent_user
MYSQL_PASSWORD=agent-password
# Optional override; otherwise start.sh derives the DSN from MYSQL_USER/PASSWORD/CONTAINER_NAME.
# MYSQL_DSN='agent_user:agent-password@tcp(mysql:3306)/agent?parseTime=true&charset=utf8mb4&loc=UTC'

# start.sh creates Redis on first deployment, then reuses it.
REDIS_CONTAINER_NAME=agent-redis
REDIS_PASSWORD=redis

# Replace this in non-demo environments with at least 32 random characters.
AUTH_SIGNING_SECRET=demo-only-change-this-signing-secret-32-chars
